{
  "name": "@twext/admin",
  "version": "0.1.0",
  "description": "An admin CLI for managing TwextHub — users, extensions, moderation, and more",
  "author": "Twext Team",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "url": "git+https://github.com/twext/admin.git"
  },
  "bin": {
    "twext-admin": "src/cli.js"
  },
  "files": [
    "src",
    "product.yml"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "turbowarp",
    "twext",
    "twexthub",
    "admin",
    "cli"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctoc": "doctoc --github --notitle README.md AGENT.md",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "doctoc": "^2.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
